	__legend__	[label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">corollary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ellipse</FONT></TD><TD BGCOLOR="#d9a6d9" BORDER="1" COLOR="Blue">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">definition</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">box</FONT></TD><TD BGCOLOR="Lavender" BORDER="1" COLOR="Purple">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">example</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">hexagon</FONT></TD><TD BGCOLOR="#eed9c4" BORDER="1" COLOR="Blue">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lemma</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">diamond</FONT></TD><TD BGCOLOR="SkyBlue" BORDER="1" COLOR="Blue">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">proposition</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pentagon</FONT></TD><TD BGCOLOR="White" BORDER="1" COLOR="Purple">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">remark</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">hexagon</FONT></TD><TD BGCOLOR="Pink" BORDER="1" COLOR="Blue">  </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">theorem</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">doublecircle</FONT></TD><TD BGCOLOR="Lavender" BORDER="1" COLOR="Blue">  </TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="6"> </FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="9">&#8212;&#8212; solid = from proof</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="9">- - - dashed = from statement</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="9">&#183;&#183;&#183;&#183; dotted = heuristic</FONT></TD></TR></TABLE>>,
		margin=0,
		shape=none];
