digraph "" {
	graph [bgcolor=transparent];
	node [label="\N",
		penwidth=1.8
	];
	edge [arrowhead=vee];
	"def:group"	[URL="def:group",
		color=Purple,
		fillcolor=Lavender,
		label=group,
		shape=box,
		style=filled,
		tooltip="def:group"];
